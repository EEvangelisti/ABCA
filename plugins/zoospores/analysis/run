#!/usr/bin/env bash
set -Eeuo pipefail

ROOT="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)/bash-scripts"

# shellcheck disable=SC1091
source "$ROOT/utils.sh"

usage() {
    cat >&2 <<'EOF'
Usage:
  ./run.sh COMMAND CONFDIR [PYTHON_COMMAND]

Available commands:
  extract
  analyse
  plot
  hysteresis
  local_parameters
  hmm
  compare
  validate
  resample
  burn_in
EOF
    exit 2
}

(( $# == 2 || $# == 3 )) || usage

COMMAND="$1"
SYSTEM_PYTHON_COMMAND="${3:-}"

require_directory "$2" "Configuration directory"
CONFDIR="$(realpath -e -- "$2")"

case "$COMMAND" in
    extract)
        SCRIPT="$ROOT/extract_trajectory_metrics.sh"
        CONFIG="$CONFDIR/extract_trajectory_metrics.conf"
        ;;
    analyse)
        SCRIPT="$ROOT/analyse_trajectory_metrics.sh"
        CONFIG="$CONFDIR/analyse_trajectory_metrics.conf"
        ;;
    plot)
        SCRIPT="$ROOT/plot_trajectory_overview.sh"
        CONFIG="$CONFDIR/plot_trajectory_overview.conf"
        ;;
    hysteresis)
        SCRIPT="$ROOT/analyse_hysteresis.sh"
        CONFIG="$CONFDIR/analyse_hysteresis.conf"
        ;;
    local_parameters)
        SCRIPT="$ROOT/extract_local_parameters.sh"
        CONFIG="$CONFDIR/extract_local_parameters.conf"
        ;;
    hmm)
        SCRIPT="$ROOT/fit_and_interpret_zoospore_hmm.sh"
        CONFIG="$CONFDIR/fit_and_interpret_zoospore_hmm.conf"
        ;;
    compare)
        SCRIPT="$ROOT/compare_models.sh"
        CONFIG="$CONFDIR/compare_models.conf"
        ;;
    validate)
        SCRIPT="$ROOT/validate_simulations.sh"
        CONFIG="$CONFDIR/validate_simulations.conf"
        ;;
    resample)
        SCRIPT="$ROOT/resample_trajectories.sh"
        CONFIG="$CONFDIR/resample_trajectories.conf"
        ;;
    burn_in)
        SCRIPT="$ROOT/apply_burn_in.sh"
        CONFIG="$CONFDIR/apply_burn_in.conf"
        ;;
    *)
        printf 'Error: unknown command: %s\n\n' "$COMMAND" >&2
        usage
        ;;
esac

require_executable "$SCRIPT" "Command"
require_file "$CONFIG" "Configuration file"

# Set up the shared Python environment.
if [[ -n "$SYSTEM_PYTHON_COMMAND" ]]; then
    "$ROOT/setup_python.sh" "$SYSTEM_PYTHON_COMMAND"
else
    "$ROOT/setup_python.sh"
fi

"$SCRIPT" "$CONFIG"
